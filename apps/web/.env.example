# Base URL of the EventCheck API, without a trailing slash.
# Matches the `Desenvolvimento local` server in docs/api-contract/openapi.yaml.
VITE_API_BASE_URL=http://localhost:8000

# 'true' serves every request from the MSW mocks derived from the contract.
# Set to 'false' once the backend is up — no component changes required.
# This covers data only: authentication always talks to the real Supabase
# project configured below, mocks or not.
VITE_USE_MOCKS=true

# --- Supabase Auth ---------------------------------------------------------
# Both values are public: they ship inside the JavaScript bundle and are meant
# to. The anon key is a publishable key whose reach is bounded by Supabase's
# row-level security, not by secrecy. The service-role key is the one that must
# never appear here, nor anywhere else in this repository.
# Both are under Project Settings -> API in the Supabase dashboard.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
