# Base URL of the EventCheck API, without a trailing slash.
# Matches the `Desenvolvimento local` server in docs/api-contract/openapi.yaml.
VITE_API_BASE_URL=http://localhost:8000

# 'true' serves every request from the MSW mocks derived from the contract.
# Set to 'false' once the backend is up — no component changes required.
VITE_USE_MOCKS=true
