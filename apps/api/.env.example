# Only secret value this service holds — the database connection string.
DATABASE_URL=postgresql+asyncpg://eventcheck:eventcheck@localhost:5432/eventcheck

# Used by the test suite. Points at a separate database so tests never touch
# development data; created automatically by docker-compose (see docker/init-test-db.sql).
TEST_DATABASE_URL=postgresql+asyncpg://eventcheck:eventcheck@localhost:5432/eventcheck_test

# Public — identifies the Supabase project. No secret is derived from this.
SUPABASE_PROJECT_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_CACHE_SECONDS=600

CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
APP_VERSION=0.1.0
